<style>
  :root {
    --ink: #141414;
    --paper: #ffffff;
    --accent: #ff6600;
    --accent-dark: #e65c00;
    --gray: #6b6b6b;
    --line: #e8e8e8;
    --soft: #f7f7f5;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; color: var(--ink); background: var(--paper); line-height: 1.6; }
  img { max-width:100%; display:block; }
  a { text-decoration:none; color:inherit; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  /* ---------- NAV ---------- */
  nav { position: fixed; top:0; left:0; right:0; z-index:100; background: rgba(20,20,20,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.08); }
  nav .wrap { display:flex; align-items:center; justify-content:space-between; height:68px; }
  .logo { display:flex; align-items:center; gap:10px; color:#fff; font-weight:800; font-size:18px; letter-spacing:-0.02em; }
  .logo img { width:38px; height:38px; border-radius:8px; object-fit:cover; }
  .logo span b { color: var(--accent); }
  .nav-links { display:flex; gap:28px; list-style:none; }
  .nav-links a { color: rgba(255,255,255,0.85); font-size:14px; font-weight:500; transition: color .2s; }
  .nav-links a:hover { color: var(--accent); }
  .nav-cta { background: var(--accent); color:#fff; padding:10px 20px; border-radius:30px; font-size:14px; font-weight:600; transition: background .2s; }
  .nav-cta:hover { background: var(--accent-dark); }
  .burger { display:none; background:none; border:none; color:#fff; font-size:24px; cursor:pointer; }

  /* ---------- HERO ---------- */
  header.hero { position:relative; min-height:100vh; display:flex; align-items:center; padding:120px 0 80px; overflow:hidden; background: #141414; }
  .hero-bg { position:absolute; inset:0; }
  .hero-bg img { width:100%; height:100%; object-fit:cover; opacity:0.35; }
  .hero-bg::after { content:""; position:absolute; inset:0; background: linear-gradient(100deg, rgba(20,20,20,0.92) 0%, rgba(20,20,20,0.65) 55%, rgba(20,20,20,0.35) 100%); }
  .hero-content { position:relative; z-index:2; max-width:680px; }
  .hero-eyebrow { display:inline-block; color: var(--accent); font-size:13px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; margin-bottom:20px; }
  .hero h1 { color:#fff; font-size: clamp(34px, 5.4vw, 60px); line-height:1.08; letter-spacing:-0.03em; font-weight:800; margin-bottom:22px; }
  .hero h1 .hl { color: var(--accent); }
  .hero p.lead { color: rgba(255,255,255,0.82); font-size: clamp(16px, 2vw, 19px); max-width: 560px; margin-bottom:34px; }
  .hero-btns { display:flex; gap:14px; flex-wrap:wrap; }
  .btn { display:inline-block; padding:15px 32px; border-radius:40px; font-size:15px; font-weight:700; transition: transform .15s, background .2s, box-shadow .2s; }
  .btn:active { transform: scale(0.97); }
  .btn-primary { background: var(--accent); color:#fff; box-shadow: 0 8px 24px rgba(255,102,0,0.35); }
  .btn-primary:hover { background: var(--accent-dark); }
  .btn-ghost { border: 1.5px solid rgba(255,255,255,0.5); color:#fff; }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .hero-meta { display:flex; gap:28px; margin-top:44px; flex-wrap:wrap; }
  .hero-meta div { color: rgba(255,255,255,0.75); font-size:13px; }
  .hero-meta b { display:block; color:#fff; font-size:17px; }

  /* ---------- SECTION BASE ---------- */
  section { padding: 96px 0; }
  .sec-head { max-width: 640px; margin-bottom: 56px; }
  .sec-head.center { margin-left:auto; margin-right:auto; text-align:center; }
  .sec-eyebrow { color: var(--accent); font-size:12px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; margin-bottom:12px; }
  .sec-head h2 { font-size: clamp(28px, 3.6vw, 42px); line-height:1.12; letter-spacing:-0.025em; font-weight:800; }
  .sec-head p { color: var(--gray); margin-top:14px; font-size:16px; }

  /* ---------- OFFERS (4 cards) ---------- */
  .offers-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .offer-card { border: 1px solid var(--line); border-radius: 16px; padding: 30px 26px; background: var(--paper); transition: transform .2s, box-shadow .2s; }
  .offer-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(20,20,20,0.08); }
  .offer-icon { width: 46px; height: 46px; border-radius: 12px; background: rgba(255,102,0,0.1); color: var(--accent); display:flex; align-items:center; justify-content:center; font-size:22px; margin-bottom: 18px; }
  .offer-card h3 { font-size:17px; font-weight:700; margin-bottom:10px; }
  .offer-card p { font-size:14px; color: var(--gray); }

  /* ---------- CATALOG ---------- */
  .catalog-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .cat-card { border: 1px solid var(--line); border-radius: 16px; overflow:hidden; background: var(--paper); transition: transform .2s, box-shadow .2s; display:flex; flex-direction:column; }
  .cat-card:hover { transform: translateY(-4px); box-shadow: 0 18px 44px rgba(20,20,20,0.09); }
  .cat-img { aspect-ratio: 4/3; overflow:hidden; background: var(--soft); }
  .cat-img img { width:100%; height:100%; object-fit:cover; transition: transform .4s; }
  .cat-card:hover .cat-img img { transform: scale(1.04); }
  .cat-body { padding: 22px 22px 24px; display:flex; flex-direction:column; flex:1; }
  .cat-art { font-size:11px; color: var(--accent); font-weight:700; letter-spacing:0.08em; text-transform:uppercase; margin-bottom:8px; }
  .cat-body h3 { font-size:18px; font-weight:700; margin-bottom:6px; }
  .cat-desc { font-size:13.5px; color: var(--gray); margin-bottom:14px; flex:1; }
  .cat-specs { font-size:12.5px; color: var(--gray); border-top: 1px solid var(--line); padding-top:12px; margin-bottom:16px; }
  .cat-specs div { margin-bottom:3px; }
  .cat-specs b { color: var(--ink); font-weight:600; }
  .cat-price { display:flex; align-items:center; justify-content:space-between; margin-top:auto; }
  .cat-price .price { font-size:19px; font-weight:800; }
  .cat-price .price small { font-size:12px; color: var(--gray); font-weight:500; }
  .cat-link { color: var(--accent); font-size:14px; font-weight:700; }
  .cat-link:hover { text-decoration: underline; }

  /* ---------- STEPS ---------- */
  .steps { background: var(--soft); }
  .steps-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: step; }
  .step-card { position:relative; background: var(--paper); border-radius:16px; padding: 30px 26px; border: 1px solid var(--line); }
  .step-num { font-size: 44px; font-weight:800; color: rgba(255,102,0,0.18); line-height:1; margin-bottom:14px; }
  .step-card h3 { font-size:16px; font-weight:700; margin-bottom:8px; }
  .step-card p { font-size:13.5px; color: var(--gray); }

  /* ---------- PRINT (шелкография) ---------- */
  .print { background: var(--ink); color:#fff; }
  .print .sec-head h2 { color:#fff; }
  .print .sec-head p { color: rgba(255,255,255,0.7); }
  .print-flex { display:grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items:center; }
  .print-list { list-style:none; display:grid; gap: 14px; }
  .print-list li { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 16px 20px; font-size: 14.5px; display:flex; gap:12px; align-items:flex-start; }
  .print-list li::before { content: "✓"; color: var(--accent); font-weight:800; flex-shrink:0; }
  .print-fact { font-size:14px; color: rgba(255,255,255,0.75); margin-top: 22px; padding: 18px 20px; border-left: 3px solid var(--accent); background: rgba(255,255,255,0.05); border-radius: 0 12px 12px 0; }

  /* ---------- NUMBERS ---------- */
  .nums-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align:center; }
  .num-card { padding: 34px 20px; border: 1px solid var(--line); border-radius: 16px; }
  .num-card .num { font-size: 46px; font-weight: 800; letter-spacing:-0.03em; color: var(--ink); line-height:1; }
  .num-card .num span { color: var(--accent); }
  .num-card .lbl { margin-top: 10px; font-size: 13.5px; color: var(--gray); }

  /* ---------- WHY ---------- */
  .why-grid { display:grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .why-item { display:flex; gap: 16px; padding: 22px; border-radius: 14px; background: var(--soft); }
  .why-item .ico { width: 40px; height: 40px; border-radius: 10px; background: rgba(255,102,0,0.12); color: var(--accent); display:flex; align-items:center; justify-content:center; font-size:19px; flex-shrink:0; }
  .why-item h3 { font-size:15.5px; font-weight:700; margin-bottom:6px; }
  .why-item p { font-size:13.5px; color: var(--gray); }

  /* ---------- CONTACTS / CTA ---------- */
  .contact { background: var(--soft); }
  .contact-flex { display:grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items:center; }
  .contact-info h2 { font-size: clamp(28px, 3.4vw, 40px); letter-spacing:-0.025em; font-weight:800; line-height:1.12; margin-bottom: 18px; }
  .contact-info > p { color: var(--gray); margin-bottom: 30px; max-width: 440px; }
  .c-list { list-style:none; display:grid; gap: 16px; }
  .c-list li { display:flex; gap: 14px; align-items:center; font-size: 15px; }
  .c-list .ico { width: 42px; height: 42px; border-radius: 12px; background: var(--paper); border: 1px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
  .c-list b { display:block; font-size: 13px; color: var(--gray); font-weight:500; }
  .c-list a { font-weight:600; }
  .c-list a:hover { color: var(--accent); }
  .c-soc { display:flex; gap: 12px; margin-top: 28px; }
  .c-soc a { padding: 11px 20px; border-radius: 30px; font-size: 13.5px; font-weight:600; border: 1px solid var(--line); background: var(--paper); transition: all .2s; }
  .c-soc a:hover { border-color: var(--accent); color: var(--accent); }

  /* ---------- FORM ---------- */
  .form-card { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: 36px; box-shadow: 0 20px 60px rgba(20,20,20,0.07); }
  .form-card h3 { font-size: 22px; font-weight:800; letter-spacing:-0.02em; margin-bottom: 8px; }
  .form-card p { font-size: 14px; color: var(--gray); margin-bottom: 24px; }
  .form-card input { width:100%; padding: 14px 18px; border: 1.5px solid var(--line); border-radius: 10px; font-size: 15px; margin-bottom: 14px; outline:none; transition: border-color .2s; background: var(--soft); }
  .form-card input:focus { border-color: var(--accent); background: var(--paper); }
  .form-card textarea { width:100%; padding: 14px 18px; border: 1.5px solid var(--line); border-radius: 10px; font-size: 15px; margin-bottom: 14px; outline:none; resize:vertical; min-height: 90px; font-family:inherit; transition: border-color .2s; background: var(--soft); }
  .form-card textarea:focus { border-color: var(--accent); background: var(--paper); }
  .form-card .btn { width:100%; border:none; cursor:pointer; text-align:center; }
  .form-note { font-size:12px; color: var(--gray); text-align:center; margin-top:12px; }

  /* ---------- FOOTER ---------- */
  footer { background: var(--ink); color: rgba(255,255,255,0.7); padding: 56px 0 32px; font-size: 13.5px; }
  footer .f-top { display:grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding-bottom: 36px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  footer h4 { color:#fff; font-size: 15px; margin-bottom: 16px; font-weight:700; }
  footer ul { list-style:none; display:grid; gap: 10px; }
  footer a:hover { color: var(--accent); }
  footer .f-brand { color: rgba(255,255,255,0.6); max-width: 320px; line-height:1.7; }
  footer .f-brand b { color:#fff; }
  .f-bottom { display:flex; justify-content:space-between; gap: 16px; padding-top: 24px; flex-wrap:wrap; font-size:12.5px; color: rgba(255,255,255,0.45); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 980px) {
    .nav-links { display:none; }
    .burger { display:block; }
    .offers-grid { grid-template-columns: repeat(2, 1fr); }
    .catalog-grid { grid-template-columns: repeat(2, 1fr); }
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .print-flex { grid-template-columns: 1fr; }
    .nums-grid { grid-template-columns: repeat(2, 1fr); }
    .why-grid { grid-template-columns: 1fr; }
    .contact-flex { grid-template-columns: 1fr; }
    footer .f-top { grid-template-columns: 1fr; gap: 28px; }
    section { padding: 72px 0; }
  }
  @media (max-width: 640px) {
    .offers-grid, .catalog-grid, .steps-grid { grid-template-columns: 1fr; }
    .nums-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .hero-btns .btn { width:100%; text-align:center; }
    .nav-cta { display:none; }
  }
  /* мобильное меню */
  .nav-links.open { display:flex; flex-direction:column; position:absolute; top:68px; left:0; right:0; background: var(--ink); padding: 20px 24px; gap:16px; border-bottom: 1px solid rgba(255,255,255,0.1); }
</style>
</head>
<body>

<!-- ================= NAV ================= -->
<nav>
  <div class="wrap">
    <a href="/" class="logo"><img src="/assets/photo.jpg" alt="JNN Factory"><span>JNN <b>FACTORY</b></span></a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#offers">Преимущества</a></li>
      <li><a href="#catalog">Каталог</a></li>
      <li><a href="#steps">Этапы работы</a></li>
      <li><a href="#print">Шелкография</a></li>
      <li><a href="#contact">Контакты</a></li>
    </ul>
    <a href="#contact" class="nav-cta">Узнать цену</a>
    <button class="burger" onclick="document.getElementById('navLinks').classList.toggle('open')">☰</button>
  </div>
</nav>

<!-- ================= HERO ================= -->
<header class="hero" id="top">
  <div class="hero-bg"><img src="/assets/260A1229.jpg" alt="Производство JNN Factory"></div>
  <div class="wrap hero-content">
    <span class="hero-eyebrow">С 2012 года · Бишкек · Кыргызстан</span>
    <h1>Швейное производство <span class="hl">полного цикла</span> в Бишкеке</h1>
